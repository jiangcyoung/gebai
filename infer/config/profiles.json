{
  "//": "infer 运行档位。所有数值来自实测（见 README 第六节），勿凭猜修改。",
  "//engine": "CUDA 后端比 Vulkan 快 2.6 倍（tg256: 143 vs 54 t/s），已设为默认",
  "//strategy": "CUDA 下 CPU-offload 代价极大（仅 6 层给 CPU 就掉 32%）；策略=用能全塞进 16GB 显存的量化（ncmoe=0）",
  "//spec": "投机解码实测无收益（ngram-mod 29.7 / ngram-cache 37.7 vs 无投机 40.3 t/s）——自由文本缺少重复模式；MTP 头不在 GGUF 中，故全部档位关闭投机",
  "version": 2,
  "engine_dir": "vendor/llama-b11100-win-cuda12.4",
  "models_dir": "../../resources/models/infer",
  "default_profile": "fast",
  "profiles": {
